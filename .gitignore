node_modules/
.wrangler/
.dev.vars
dist/
.claude/

# OS cruft
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local telemetry footage for testing imports (PDR MP4s, VBO, GoPro) —
# real video files, never committed
telemetry-samples/

# Personal data stays out of the repo
seed/data.personal.mjs
seed/seed.sql

# Local design system reference (not part of the app)
Track History design system/

# Scratch D1 the contract harness builds and tears down each run
# (contracts/golden/ itself IS committed — it's the pinned API contract)
contracts/.persist/

# Native client build output. The Gradle wrapper itself IS committed, so CI
# needs no local Gradle install.
apps/android/.gradle/
apps/android/build/
apps/android/*/build/
apps/android/local.properties

# iOS build output and per-user Xcode state. TrackEvolution.xcodeproj IS
# committed (generated from project.yml by apps/ios/generate.sh) so a clean
# checkout builds with nothing but Xcode; Package.resolved is committed too, to
# pin dependency versions.
apps/ios/build/
apps/ios/DerivedData/
apps/ios/**/.build/
*.xcuserdatad
xcuserdata/
