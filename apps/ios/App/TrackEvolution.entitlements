<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay driving task (NS-19): start and stop a lap recording from the
	     head unit. Apple-granted — the capability must be enabled on the
	     app.trackevolution App ID or signing fails for every device build, so a
	     signing failure mentioning this key means the profile needs regenerating
	     (Xcode → Settings → Accounts → Download Manual Profiles), not that the key
	     is wrong. -->
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
	<!-- Universal Links for /share/* and /coach/* (NS-38) — the association file is served by
	     src/routes/wellKnown.ts. Deliberately absent:
	     com.apple.developer.applesignin (added with Sign in with Apple, NS-08). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:trackevolution.app</string>
	</array>
	<!-- Push notifications for coach comments (NS-54), delivered by FCM through
	     APNs. APS_ENVIRONMENT is set per configuration in project.yml:
	     development for Debug, production for Release. The Push Notifications
	     capability must be on the app.trackevolution App ID. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
