<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links for /share/* — the association file is served by
	     src/routes/wellKnown.ts. Deliberately absent:
	     com.apple.developer.carplay-driving-task (Apple-granted; signing fails
	     without the grant, so NS-19 adds it) and
	     com.apple.developer.applesignin (added with Sign in with Apple, NS-08). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:trackevolution.app</string>
	</array>
</dict>
</plist>
