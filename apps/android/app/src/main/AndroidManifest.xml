<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifest baseline for the native Android client (spec: NS-02).

    Permissions here are DECLARED, not requested. The runtime requests belong to
    the feature that needs them — location to NS-16, POST_NOTIFICATIONS to the
    recorder's foreground-service notification — so the user is asked in context
    rather than at launch.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lap recording. Background location is what lets fixes keep flowing with
         the phone locked in the driver's pocket; the foreground service is how
         Android 14+ allows it at all. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 13+ needs this granted at runtime for the recording
         notification to be *visible*. The Capacitor app never requested it,
         which is why its notification silently never appeared. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- GPS is required for the recorder, but the logbook works without it, so
         this stays non-required rather than excluding tablets from the store. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".TrackEvolutionApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrackEvolution">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TrackEvolution.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme the server redirects to after system-browser
                 OAuth. Wired up in NS-09. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="trackevolution" android:host="auth" />
            </intent-filter>

            <!-- App Links: open share pages in the app, verified against
                 https://trackevolution.app/.well-known/assetlinks.json. The
                 fingerprint there is the Play app-signing key, so verification
                 only succeeds for a Play-signed build. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="trackevolution.app"
                    android:pathPrefix="/share/" />
            </intent-filter>
        </activity>

        <!--
            The lap recorder (NS-16). The *service* owns the recording, not the
            activity, which is what lets it keep taking fixes with the screen off
            and after the app is swiped out of recents.

            foregroundServiceType="location" is what buys that on Android 10+;
            it also means the system kills the process unless startForeground is
            called within five seconds of startForegroundService, which
            RecordingService is built around.

            Not exported: nothing outside the app has any business starting a
            GPS recording.
        -->
        <service
            android:name=".recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
