<?xml version="1.0" encoding="utf-8"?>
<!--
    Two themes, and the split matters:

    Theme.TrackEvolution.Splash is the *launch* theme. It only exists for the
    handful of frames between the launcher tap and Compose drawing, so it draws
    the brand mark on the brand background instead of a white flash.
    androidx.core.splashscreen swaps it for the real theme in installSplashScreen(),
    and backports the Android 12 splash to the API 26-30 devices minSdk allows.

    Theme.TrackEvolution is what the app actually runs in, and stays deliberately
    thin: Compose draws everything above it from the tokens in
    app/src/main/kotlin/app/trackevolution/ui/theme (NS-07). All it owns is the
    window chrome — which has to be right *before* Compose composes, so it
    follows the system's light/dark through values-night rather than the in-app
    theme override.
-->
<resources>

    <style name="Theme.TrackEvolution" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Dark icons, for the light chrome above. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.TrackEvolution.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TrackEvolution</item>
    </style>

</resources>
