<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only additions (spec: NS-07).

  The token gallery gets its own launcher entry rather than a hidden route in
  the app, so reviewing the design system against the web app is one tap and
  needs no signed-in state. It exists only in debug builds — this manifest is
  never merged into a release APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Cleartext to the dev server, debug builds only (NS-09). `wrangler dev`
      serves plain HTTP and the server's DEV_MODE bypass answers on 10.0.2.2,
      the emulator's alias for the host. Scoped to those hosts in res/xml, and
      here rather than in main, so no release build can ship it.
    -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".ui.theme.TokenGalleryActivity"
            android:label="@string/token_gallery_label"
            android:exported="true"
            android:theme="@style/Theme.TrackEvolution">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The chart bench (NS-24). Charts are drawn rather than laid out, so
             a unit test cannot tell you a trace came out mirrored or a ramp
             backwards; this shows all four in both themes, and carries the
             20,000-fix line picker the spec asks to be profiled. -->
        <activity
            android:name=".ui.charts.ChartGalleryActivity"
            android:label="@string/chart_gallery_label"
            android:exported="true"
            android:theme="@style/Theme.TrackEvolution">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The recorder bench (NS-16). The real recording screen is NS-18; this
             exists so a service, a permission ladder and a durability guarantee
             can be exercised before that lands. -->
        <activity
            android:name=".recording.RecorderHarnessActivity"
            android:label="@string/recorder_harness_label"
            android:exported="true"
            android:theme="@style/Theme.TrackEvolution">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Android Auto (NS-20), debug builds only.

          This shipped in the release manifest once and got the app REJECTED by
          Play: the Car App Library has no driving-task category, POI was
          declared as the least-bad fit, and the car review judged it against
          PF-1 ("meaningful functionality relevant to driving" *in the declared
          category") — which a lap timer does not have and cannot acquire. The
          review fires on any submission carrying a car-compatible artifact while
          the Android Auto form factor is opted in, and a failure in the
          production track rejects the WHOLE submission, freezing ordinary phone
          updates too. See docs/specs/native/NS-20-android-auto.md.

          So it lives here, next to the token gallery and the chart bench, for
          the same reason they do: a release APK must not contain it at all,
          rather than merely not reach it. The Desktop Head Unit runs debug
          builds, so this stays fully testable.

          Re-promoting this to src/main is a Play-policy decision, not a build
          one — it needs a category that permits a driving task to exist first.
        -->
        <service
            android:name=".auto.TrackAutoService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Without this pair Android Auto never discovers the service. See the
             comment in res/xml/automotive_app_desc.xml. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>
