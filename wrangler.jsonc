{
  // Cloudflare Workers config — https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "track-history",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    // The Worker reads index.html through this binding to serve share pages
    // with per-slug OG meta tags (src/routes/share.ts sharePage).
    "binding": "ASSETS",
    // apple-app-site-association is extensionless, so the Worker must serve
    // it to get Content-Type: application/json (see src/routes/wellKnown.ts).
    // /share/* hits the Worker so link scrapers get per-slug OG meta instead
    // of the SPA shell's generic tags. /billing/* are the store webhooks
    // (src/routes/billingWebhooks.ts), public and outside /api. /mcp, /oauth/*
    // and the two OAuth discovery documents are the MCP server and its
    // authorization server (src/routes/mcp.ts, oauth.ts) — without these the
    // SPA fallback would answer them with index.html. /get is the store
    // redirect (src/routes/download.ts), which picks a store per User-Agent.
    // /clips/* are the signed best-lap video URLs (src/routes/clips.ts, NS-45).
    // /youtube/* is connecting YouTube (src/routes/youtube.ts, NS-46): the
    // consent round trip with Google, which must not get the SPA shell.
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/share/*",
      "/billing/*",
      "/get",
      "/clips/*",
      "/youtube/*",
      "/.well-known/apple-app-site-association",
      "/.well-known/openai-apps-challenge",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/*",
      "/.well-known/oauth-authorization-server",
    ],
  },
  "vars": {
    // <Apple Team ID>.<bundle id> for iOS Universal Links (mobile/ apps).
    // Override for self-hosted forks.
    "IOS_APP_ID": "L3NS86NMXZ.app.trackevolution",
    // YouTube (NS-46): the project's uploads per Pacific day, set from the
    // quota the Google project's page shows (ticket 0). Empty: no budget.
    // YOUTUBE_ALLOWLIST is deliberately NOT a var here: a deploy replaces every
    // var with this file's, so an allowlist set anywhere else would be wiped
    // and the feature opened to everyone. It is a secret, which survives.
    "YOUTUBE_DAILY_BUDGET": "",
  },
  // Rate limits (src/lib/ratelimit.ts) — the MCP surface's, and the logbook
  // export's. namespace_id is account-scoped:
  // any integer not used by another Worker on the same account.
  "ratelimits": [
    // Tool calls per connected assistant: a chat digging into a session makes
    // 5-15, so 60 a minute is a runaway loop, not a user.
    { "name": "MCP_CALLS", "namespace_id": "3141", "simple": { "limit": 60, "period": 60 } },
    // Token requests per client: normal use is one refresh an hour.
    { "name": "OAUTH_TOKEN", "namespace_id": "3142", "simple": { "limit": 10, "period": 60 } },
    // Registrations per IP. Generous, because an assistant's servers register
    // on behalf of every user who connects through them.
    { "name": "OAUTH_REGISTER", "namespace_id": "3143", "simple": { "limit": 60, "period": 60 } },
    // Logbook exports per user (NS-44): three files plus a retry or two is a
    // minute's normal use; a full JSON export with telemetry is the heaviest
    // read the Worker serves.
    { "name": "EXPORT", "namespace_id": "3144", "simple": { "limit": 5, "period": 60 } },
    // Best-lap video part uploads per user (NS-45): a clip is ~3 parts of
    // 50 MiB, so 60 a minute is a client stuck in a retry loop.
    { "name": "CLIP_PARTS", "namespace_id": "3145", "simple": { "limit": 60, "period": 60 } },
  ],
  // Best-lap video clips (NS-45, src/routes/clips.ts). No public access and no
  // custom domain: every byte goes through /clips/* and its signed URLs.
  // Create with `npx wrangler r2 bucket create track-evolution-clips`.
  // Publish a best-lap video to YouTube (NS-46, src/youtube/step.ts): the
  // server copies the clip from R2 to YouTube one 32 MiB chunk per message.
  // One message at a time per invocation; after max_retries a message goes to
  // the dead-letter queue, whose consumer (the same Worker) fails its row in
  // words. Create both with `npx wrangler queues create track-evolution-youtube`
  // and `… track-evolution-youtube-dlq` before deploying. Queues need the
  // Workers Paid plan.
  "queues": {
    "producers": [{ "binding": "YOUTUBE_QUEUE", "queue": "track-evolution-youtube" }],
    "consumers": [
      {
        "queue": "track-evolution-youtube",
        "max_batch_size": 1,
        "max_retries": 10,
        "dead_letter_queue": "track-evolution-youtube-dlq",
      },
      { "queue": "track-evolution-youtube-dlq", "max_batch_size": 10 },
    ],
  },
  "r2_buckets": [{ "binding": "CLIPS", "bucket_name": "track-evolution-clips" }],
  "d1_databases": [
    {
      // Must match what the Worker code reads (c.env.DB in src/*.ts)
      "binding": "DB",
      "database_name": "track-history",
      "database_id": "f29ad240-bee3-438f-bef9-ddd8681a9f5b",
    },
  ],
  // Daily subscription re-verification against the stores (src/cron.ts) —
  // the slow path behind the webhooks.
  "triggers": {
    "crons": ["17 9 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
